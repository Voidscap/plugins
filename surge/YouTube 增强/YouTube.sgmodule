#!name = YouTube 增强
#!desc = 去除 YouTube 广告，支持后台播放、画中画
#!author = gholts, Maasea
#!homepage = https://github.com/IBL3ND/module
#!system = ios
#!category = YouTube

# 由 Egern 模块转换而来，原作者 gholts、Maasea（Egern 版由 IBL3ND 整理）
# 原链接：https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/Egern-YouTube.yaml
# 原作者的 Surge 版：https://github.com/gholts/surge/blob/main/modules/youtube-enhance.sgmodule
# 转换说明：
# - 三个脚本（youtube-request.js、youtube-response.js、YT-CC-ASR-Auto.js）本来就是
#   Surge 风格的 $request / $response / $argument / $done 写法，原样复制，未改动，
#   只把 Egern 的 _compat.$argument 注入换成了 Surge 脚本自带的 argument 参数。
# - Egern 的 rules 用 Surge 逻辑规则翻译；rewrites 里返回空 200 的 4 条，
#   Surge 的 URL Rewrite 没有“返回 200”这种类型，改成 - reject（原作者 Surge 版
#   对 pagead / stats/ads 也是这么做的），效果都是拦掉广告/埋点请求。
# - 选项默认值按 Egern 版：上传、Shorts、小游戏、竖屏直播、Jump Ahead、商店、自动最高画质、
#   原生下载全开。注意 Egern 里“屏蔽选段按钮”这个选项声明了但没传给任何脚本，是个摆设，
#   这里没收。原作者 Surge 版多了 block_ai / on_the_go，Egern 版没有，这里也没加；
#   blockShorts / blockVerticalLive 的默认值 Egern 版是 true，原作者 Surge 版是 false，
#   这里按 Egern 版的 true。
# - 需 MITM，必须装好并信任 Surge 的 MITM 证书；YouTube 有证书 pinning 风险，
#   若播放异常先关掉本模块排查。

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad - reject
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)([^#]+)&tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$2&$4&subtype=Translate$5 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)([^#]+)&tlang=([^&#]+)(#.*)?$ https://$1$2&subtype=Translate$4 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$3&subtype=Translate$4 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)tlang=([^&#]+)(#.*)?$ https://$1subtype=Translate$3 302

[Script]
youtube.enhance.ad-break = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,engine=jsc,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/youtube-request.js
youtube.enhance.download = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/youtube-response.js,argument="{\"nativeDownload\":true}"
youtube.enhance.download-player = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/youtube-request.js,argument="{\"nativeDownload\":true}"
youtube.enhance.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/youtube-response.js,argument="{\"blockUpload\":true,\"blockShorts\":true,\"blockGames\":true,\"blockVerticalLive\":true,\"jumpAhead\":true,\"autoHd\":true,\"blockStore\":true}"
youtube.enhance.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/youtube-response.js,argument="{\"blockGames\":true,\"blockVerticalLive\":true,\"jumpAhead\":true,\"autoHd\":true,\"blockStore\":true}"
youtube.enhance.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/youtube-request.js
youtube.enhance.auto-hd = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/youtube-request.js,argument="{\"autoHd\":true}"
youtube.enhance.log-event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/youtube-request.js
youtube.enhance.dual-subs = type=http-response,pattern=^https:\/\/(?:www|m)\.youtube\.com\/api\/timedtext(?:\?|$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Voidscap/plugins/main/surge/YouTube%20%E5%A2%9E%E5%BC%BA/YT-CC-ASR-Auto.js

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, m.youtube.com
